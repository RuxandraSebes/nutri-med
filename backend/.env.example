MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=nutrimed
MYSQL_USER=root
MYSQL_PASSWORD=secret

API_GATEWAY_PORT=3000
PATIENT_SERVICE_PORT=3001
MEDICAL_SERVICE_PORT=3002
RECOMMENDATION_SERVICE_PORT=3003

PATIENT_SERVICE_URL=http://localhost:3001
MEDICAL_SERVICE_URL=http://localhost:3002
RECOMMENDATION_SERVICE_URL=http://localhost:3003
AUTH_SERVICE_URL=http://localhost:3010
# Python AI (Flask, port 5001 in container). Host mapped to 3011 in docker-compose.
# From recommendation-service inside Compose use http://ai-service:5001 (set in docker-compose).
AI_SERVICE_URL=http://localhost:3011
OLLAMA_HOST=http://localhost:11434

# Same secret on auth-service, patient-service, medical-service, recommendation-service
JWT_SECRET=change-me-to-a-long-random-string

# Browser → gateway (CORS). Use http://localhost:5173 in dev if you restrict origin.
CORS_ORIGIN=*
