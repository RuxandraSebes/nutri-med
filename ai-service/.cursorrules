{
  "rules": [
    {
      "pattern": "**/*.js",
      "message": "Use modern ES6+ syntax. Ensure error handling in Express routes."
    },
    {
      "pattern": "ai-service/**/*.py",
      "message": "Use Python 3.12+. Enforce type hinting. This service handles LLM integrations (Mistral) and must remain independent of Node.js logic."
    },
    {
      "pattern": "frontend/**/*.jsx",
      "message": "Use functional React components with Hooks. Prioritize using shadcn/ui components for all new UI elements."
    },
    {
      "pattern": "frontend/**/*.tsx",
      "message": "Use functional React components with Hooks. Prioritize using shadcn/ui components for all new UI elements. Ensure strict TypeScript typing."
    },
    {
      "pattern": "docker-compose.yml",
      "message": "Ensure network bridges allow the Node.js API Gateway to communicate with the Python AI Service container."
    }
  ]
}
